@@ -0,0 +1,56 @@
+"""
+    MLFScore
+
+A node-selection score for the minimum local fill code. The heap key of a
+supernode `j` is
+
+    mlfscore(score, def, deg)
+
+where `def` is the (weighted) deficiency of `j` and `deg` is the (weighted)
+degree of a representative vertex of `j` in the elimination graph: the weight of
+its open neighborhood, including the other members of its supernode.
+
+A score must be nondecreasing in `def` for fixed `deg`: when a node outside of
+the elimination clique has its deficiency reduced, its degree does not change,
+so `genmf_wh` only moves it up the heap.
+"""
+abstract type MLFScore end
+
+"""
+    MinFill <: MLFScore
+
+Minimum local fill: the key is the deficiency.
+"""
+struct MinFill <: MLFScore end
+
+"""
+    MinAvgFill <: MLFScore
+
+Minimum average fill: the key is the deficiency divided by the degree. Vertices
+of degree zero have key zero.
+"""
+struct MinAvgFill <: MLFScore end
+
+"""
+    scoretype(score::MLFScore, W)
+
+The type of the heap keys produced by `score` for weights of type `W`.
+"""
+scoretype(::MinFill, ::Type{W}) where {W} = W
+scoretype(::MinAvgFill, ::Type{W}) where {W} = promote_type(Float64, W)
+
+@inline function mlfscore(::MinFill, def::W, deg::W) where {W}
+    return def
+end
+
+@inline function mlfscore(score::MinAvgFill, def::W, deg::W) where {W}
+    S = scoretype(score, W)
+
+    if iszero(deg)
+        key = zero(S)
+    else
+        key = convert(S, def) / convert(S, deg)
+    end
+
+    return key
+end
